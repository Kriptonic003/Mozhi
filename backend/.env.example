# MOZHI Backend Environment Configuration

# Application
APP_NAME=MOZHI
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api

# Security
SECRET_KEY=mozhi_development_secret_key_change_in_production_994829148
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/mozhi
# For SQLite (default development fallback): sqlite:///./mozhi.db
DATABASE_URL=sqlite:///./mozhi.db

# Audio Storage
UPLOAD_DIR=uploads
MAX_AUDIO_SIZE_MB=25

# Machine Learning & Whisper Model
# Pretrained fallback if local checkpoint is not yet fine-tuned:
WHISPER_MODEL_NAME_OR_PATH=openai/whisper-small
DEVICE=cpu

# Optional AI Services (Gemini API for polishing and summaries)
GEMINI_API_KEY=
