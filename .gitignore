# ============================================
# MOZHI - Git Ignore
# ============================================

# ---- Environment Variables ----
.env
.env.local
.env.*.local
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.pyc

# ---- Virtual Environments ----
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ---- Database ----
*.sqlite3
*.db

# ---- Audio Uploads (user recordings) ----
backend/uploads/*
!backend/uploads/.gitkeep
temp_audio/

# ---- ML Model Weights & Checkpoints ----
# Large binary files — do NOT push to git
models/mozhi-whisper-small/
!models/.gitkeep
!models/README.md
*.pt
*.safetensors
*.bin
!requirements*.txt

# ---- ML Datasets (raw audio + generated manifests) ----
ml/dataset/raw/mlenspeech/
!ml/dataset/raw/.gitkeep
ml/dataset/processed/*
!ml/dataset/processed/.gitkeep
ml/experiments/checkpoints/

# Generated data files (reproducible via scripts)
ml/dataset/mlenspeech_raw_manifest.jsonl
ml/dataset/mlenspeech_to_romanize.csv

# ---- ML Training Artifacts ----
wandb/
runs/
tensorboard/
*.ckpt

# ---- HuggingFace Cache ----
.cache/
huggingface/

# ---- Jupyter Notebooks ----
.ipynb_checkpoints/

# ---- Node / Frontend ----
node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/

# ---- IDE & OS ----
.idea/
.vscode/
*.swp
*.swo
*.bak
.DS_Store
Thumbs.db
desktop.ini

# ---- Temp / Diagnostic Files ----
backend/diagnose.py
backend/test_dummy.wav
*.tmp
*.log
