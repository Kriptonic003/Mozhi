# Git Ignore for MOZHI

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Database
*.sqlite3
*.db
mozhi.db

# Audio / Uploads
backend/uploads/*
!backend/uploads/.gitkeep
temp_audio/
*.wav
*.mp3
*.m4a
*.flac
*.ogg

# ML Model Weights, Checkpoints & Datasets
models/*
!models/.gitkeep
!models/README.md
ml/dataset/raw/*
!ml/dataset/raw/.gitkeep
ml/dataset/processed/*
!ml/dataset/processed/.gitkeep
ml/dataset/train/*
!ml/dataset/train/.gitkeep
ml/dataset/validation/*
!ml/dataset/validation/.gitkeep
ml/dataset/test/*
!ml/dataset/test/.gitkeep
ml/experiments/checkpoints/
*.pt
*.bin
*.safetensors
wandb/
runs/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
